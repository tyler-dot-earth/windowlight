#!/usr/bin/env bash
# windowlight adapter: signals about this machine, every few seconds
#   cpu   share of all cores busy
#   net   traffic in and out, on a log scale from 1 KB/s (0) to 100 MB/s (1)
#   disk  share of / used
# usage: adapters/system [SECONDS]      (writes to $WINDOWLIGHT_SIGNALS, else $XDG_RUNTIME_DIR/windowlight/signals)
set -euo pipefail
dir=${WINDOWLIGHT_SIGNALS:-${XDG_RUNTIME_DIR:-/tmp}/windowlight/signals}
every=${1:-2}
mkdir -p "$dir"
put() { printf '{"level": %s, "label": "%s", "ttl": 15}\n' "$2" "$3" > "$dir/.$1.tmp"; mv "$dir/.$1.tmp" "$dir/$1.json"; }
cpu() { awk '/^cpu /{ print $2+$3+$4+$7+$8, $2+$3+$4+$5+$6+$7+$8+$9 }' /proc/stat; }
net() { awk -F'[: ]+' 'NR > 2 && $2 != "lo" { s += $3 + $11 } END { printf "%.0f\n", s }' /proc/net/dev; }
now() { date +%s.%N; }
read -r busy0 all0 < <(cpu); n0=$(net); t0=$(now)
while true; do
  sleep "$every"
  read -r busy1 all1 < <(cpu); n1=$(net); t1=$(now)
  put cpu "$(awk -v b=$((busy1 - busy0)) -v a=$((all1 - all0)) 'BEGIN { printf "%.3f", (a > 0 ? b / a : 0) }')" "processor"
  put net "$(awk -v d="$((n1 - n0))" -v t0="$t0" -v t1="$t1" 'BEGIN { r = d / (t1 - t0); x = r > 1000 ? log(r / 1000) / log(10) / 5 : 0; printf "%.3f", (x > 1 ? 1 : x) }')" "network"
  put disk "$(df -P / | awk 'NR == 2 { sub("%", "", $5); printf "%.3f", $5 / 100 }')" "disk /"
  busy0=$busy1 all0=$all1 n0=$n1 t0=$t1
done
